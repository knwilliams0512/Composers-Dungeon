# Copy this file to .env and adjust values.
#
# There are two ways to run Composer's Dungeon, and they want different
# variables. Everything under DESKTOP is what the Windows installer sets for
# itself; everything under HOSTED is what you set on the server. Nothing is
# shared between them but NEXTAUTH_SECRET's purpose.

# ---------------------------------------------------------------------------
# DESKTOP / local development — a SQLite file, no services, works offline
# ---------------------------------------------------------------------------

# SQLite database file (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# NextAuth configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# HOSTED — a shared Postgres, so players can reach each other's guilds
# ---------------------------------------------------------------------------
# Set these INSTEAD of the SQLite DATABASE_URL above. See DEPLOY.md.
#
# DATABASE_URL="postgresql://user:password@host:5432/composers_dungeon?sslmode=require"
#
# Migrations run through this rather than through DATABASE_URL. Hosts that put
# a connection pooler in front of Postgres — Neon and Supabase both do — serve
# a pooled URL that cannot run DDL. Set it to the host's *direct* connection
# string, or to the same value as DATABASE_URL when there is no pooler. Prisma
# fails to start if it is missing entirely.
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/composers_dungeon?sslmode=require"
#
# Tells the app it is Postgres, which the library search needs: SQLite's LIKE
# ignores case and Postgres's does not, so without this, searching the library
# for "fugue" stops finding "Fugue in D".
# DATABASE_PROVIDER="postgresql"
#
# Marks this as a server other people reach. Turns off the self-updater, which
# a hosted instance cannot apply, and stops password resets falling back to a
# link written in a file on the server that nobody can read.
# CD_HOSTED="1"
#
# Must be the public URL players type, with no trailing slash. Password-reset
# links are built from it, and NextAuth rejects sessions when it is wrong.
# NEXTAUTH_URL="https://your-app.example.com"
#
# The address of whoever runs this server. On a hosted instance only this
# account may change the sender under Settings -> Email, because the sender is
# what decides where password-reset mail goes: any other player who could
# change it could point every reset in the game at a mailbox of their own.
# Unset, nobody can change it — including you. Sign up with this address first.
# CD_ADMIN_EMAIL="you@example.com"
#
# The Dockerfile sets DATABASE_PROVIDER, CD_HOSTED, PORT and HOSTNAME already,
# so a Docker deploy only needs DATABASE_URL, DIRECT_DATABASE_URL,
# NEXTAUTH_URL, NEXTAUTH_SECRET and CD_ADMIN_EMAIL.
