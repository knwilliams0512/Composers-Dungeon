{
  "name": "composers-dungeon",
  "version": "1.19.0",
  "private": true,
  "description": "An educational music theory & composition platform fused with an RPG dungeon crawler.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "npm install && prisma generate && prisma db push && tsx prisma/seed.ts",
    "win:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install.ps1",
    "win:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "win:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/stop.ps1",
    "win:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/update.ps1",
    "win:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/uninstall.ps1",
    "check:content": "node scripts/check-content.mjs",
    "check:theory": "node scripts/check-theory.mjs",
    "check:notation": "tsx scripts/check-notation.ts",
    "check:studio": "tsx scripts/check-studio.ts",
    "check:musicxml": "tsx scripts/check-musicxml.ts",
    "check:midi": "tsx scripts/check-midi.ts",
    "check:print": "node scripts/check-print.mjs",
    "check:practice": "tsx scripts/check-practice.ts",
    "check:questions": "tsx scripts/check-questions.ts",
    "check:awards": "node scripts/check-awards.mjs",
    "check:chords": "tsx scripts/check-chords.ts",
    "check:timing": "tsx scripts/check-timing.ts",
    "check:marks": "tsx scripts/check-marks.ts",
    "check:all": "npm run check:content && npm run check:figures && npm run check:progression && npm run check:drills && npm run check:beams && npm run check:briefs && npm run check:raids && npm run check:exams && npm run check:routes && npm run check:actions && npm run check:json && npm run check:flatten && npm run check:upgrade && npm run check:launcher && npm run check:update-status && npm run check:schemas && npm run check:claims && npm run check:theory && npm run check:notation && npm run check:studio && npm run check:musicxml && npm run check:midi && npm run check:print && npm run check:practice && npm run check:questions && npm run check:awards && npm run check:chords && npm run check:timing && npm run check:marks",
    "check:progression": "node scripts/check-progression.mjs",
    "build:hosted": "node scripts/make-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma && next build",
    "db:push:hosted": "prisma db push --schema prisma/schema.postgres.prisma --skip-generate",
    "make:pg-schema": "node scripts/make-postgres-schema.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:claims": "tsx scripts/check-claims.ts",
    "make:icons": "node scripts/make-icons.mjs",
    "make:cover": "node scripts/make-cover.mjs",
    "schema:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/schema.sql",
    "check:upgrade": "node scripts/check-upgrade.mjs",
    "check:drills": "tsx scripts/check-drills.ts",
    "check:launcher": "node scripts/check-launcher.mjs",
    "check:raids": "node scripts/check-raids.mjs",
    "check:exams": "tsx scripts/check-exams.ts",
    "check:update-status": "node scripts/check-update-status.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "check:flatten": "tsx scripts/check-flatten.ts",
    "check:json": "node scripts/check-json.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:briefs": "tsx scripts/check-briefs.ts",
    "check:beams": "tsx scripts/check-beams.ts",
    "check:figures": "tsx scripts/check-figures.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.15",
    "next-auth": "^4.24.10",
    "nodemailer": "^7.0.13",
    "puppeteer-core": "^25.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
